---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Start a project — PageFix" description="Tell PageFix what your business needs to improve. Start a conversation about brand strategy, digital product design, web development or automation.">
  <section class="start-page wrap">
    <div class="start-intro"><span class="eyebrow">Start a project</span><h1>TELL US WHAT NEEDS <span>FIXING.</span></h1><p>Give us the messy version. You do not need a perfect brief — we will work out the next useful step.</p><div class="contact-note"><strong>What happens next</strong><br />We’ll read your context and follow up about the most useful next step. If email works better, reach us at<br /><a href="mailto:pagefixed@gmail.com">pagefixed@gmail.com ↗</a></div></div>
    <form class="form" id="enquiry-form">
      <div class="field"><label for="name">Name *</label><input id="name" name="name" required autocomplete="name" placeholder="Your name" /></div>
      <div class="field"><label for="email">Email *</label><input id="email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" /></div>
      <div class="field"><label for="company">Company</label><input id="company" name="company" autocomplete="organization" placeholder="Company / brand" /></div>
      <div class="field"><label for="service">What do you need? *</label><select id="service" name="service" required><option value="">Select one</option><option>Template / digital product</option><option>Brand strategy</option><option>UI / UX / product design</option><option>Website / digital solution</option><option>AI / automation</option><option>Business software</option><option>Not sure yet</option></select></div>
      <div class="field"><label for="message">Tell us about it *</label><textarea id="message" name="message" required placeholder="What are you trying to build, improve or automate?"></textarea></div>
      <button class="button primary submit-button" type="submit">SEND ENQUIRY ↗</button>
      <div class="form-status" id="form-status" role="status" aria-live="polite"></div>
    </form>
  </section>
  <script is:inline>
    const form=document.querySelector('#enquiry-form'); const status=document.querySelector('#form-status'); const params=new URLSearchParams(window.location.search); const offer=params.get('offer'); if(offer&&form){form.elements.message.value=`I'm interested in: ${offer}.\n\n`;form.elements.service.value=offer.toLowerCase().includes('template')||offer.toLowerCase().includes('kit')?'Template / digital product':'Website / digital solution';}
    form?.addEventListener('submit',async e=>{e.preventDefault(); status.className='form-status'; status.textContent='Sending…'; const data=Object.fromEntries(new FormData(form)); try{const r=await fetch('/api/enquiry',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)}); const out=await r.json(); if(!r.ok) throw new Error(out.message||'Could not send enquiry.'); form.reset(); status.className='form-status success'; status.textContent='Enquiry received. We’ll get back to you soon.';}catch(err){status.className='form-status error';status.textContent=err.message||'Could not send enquiry.';}});
  </script>
</Layout>
