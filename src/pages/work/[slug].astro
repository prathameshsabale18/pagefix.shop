---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';
import { caseStudies } from '../../data/caseStudies';
import { projectVisuals } from '../../data/projectVisuals';

export const prerender = true;

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug }
  }));
}

const slug = Astro.params.slug;

const project = projects.find((item) => item.slug === slug);

if (!project) {
  throw new Error(`Project not found: ${slug}`);
}

const study = caseStudies[project.slug];
---

<Layout title={`${project.title} — ${project.category.toLowerCase()} case study | PageFix`} description={study?.heroDescription ?? project.description}>
  {study ? (
    <div class={`case-study case-${study.slug}`}>
      <section class="case-hero wrap">
        <a class="back-link" href="/work">← ALL WORK</a>
        <div class="case-hero-grid">
          <div>
            <span class="eyebrow">{study.heroLabel}</span>
            <h1>{study.heroTitle}</h1>
          </div>
          <div class="case-hero-copy">
            <p>{study.heroDescription}</p>
            {project.slug === 'autobon' && <a class="case-live-link" href="https://autobon.ca" target="_blank" rel="noopener noreferrer">VISIT AUTOBON.CA <span aria-hidden="true">↗</span></a>}
          </div>
        </div>
      </section>

      <section class="case-hero-visual wrap">
        <figure class="case-visual"><img src={project.slug === 'autobon' ? '/images/autobon.ca/01.webp' : project.image} alt={`${project.title} ${project.category.toLowerCase()} design`} fetchpriority="high" /><figcaption><span>{project.number} / {project.category}</span><span>PageFix project</span></figcaption></figure>
      </section>

      {projectVisuals[project.slug]?.length > 0 && (
        <section class="case-gallery wrap" aria-labelledby="case-gallery-title">
            <div class="case-gallery-heading"><span class="eyebrow">Inside the project</span><h2 id="case-gallery-title">A closer look at the work.</h2><p>Screens and visuals from the project.</p></div>
          <div class="case-gallery-grid">
            {projectVisuals[project.slug].map((visual, index) => (
              <figure class="case-gallery-item">
                <img src={visual.src} alt={visual.alt} loading="lazy" />
                <figcaption><span>{String(index + 1).padStart(2, '0')}</span>{visual.caption}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}

      <section class="case-section case-snapshot wrap">
        <div class="case-section-label">
          <span class="eyebrow">02</span>
          <span class="case-section-label-name">PROJECT SNAPSHOT</span>
        </div>
        <div class="snapshot-grid">
          {study.snapshot.map((item) => (
            <div class="snapshot-item">
              <span>{item.label}</span>
              <strong>{item.value}</strong>
            </div>
          ))}
        </div>
      </section>

      <section class="case-section wrap">
        <div class="case-section-label">
          <span class="eyebrow">03</span>
          <span class="case-section-label-name">THE PRODUCT</span>
        </div>
        <div class="case-two-col">
          <h2>{study.product.title}</h2>
          <div>
            <p class="case-lead">{study.product.body}</p>
            <div class="case-fact-list">
              {study.product.bullets.map((item, index) => (
                <div class="case-fact">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <p>{item}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="case-section case-dark-block">
        <div class="wrap">
          <div class="case-section-label">
            <span class="eyebrow">04</span>
            <span class="case-section-label-name">THE PROBLEM</span>
          </div>
          <div class="case-two-col">
            <h2>{study.problem.title}</h2>
            <div>
              <p class="case-lead">{study.problem.body}</p>
              <div class="case-point-list">
                {study.problem.points.map((point) => (
                  <div class="case-point">
                    <span>—</span>
                    <p>{point}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="case-section wrap">
        <div class="case-section-label">
          <span class="eyebrow">05</span>
          <span class="case-section-label-name">THE APPROACH</span>
        </div>
        <div class="case-two-col">
          <h2>{study.approach.title}</h2>
          <div>
            <p class="case-lead">{study.approach.body}</p>
            <div class="approach-list">
              {study.approach.steps.map((step, index) => (
                <div class="approach-item">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <strong>{step}</strong>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="case-section wrap case-flow-section">
        <div class="case-section-label">
          <span class="eyebrow">06</span>
          <span class="case-section-label-name">INFORMATION ARCHITECTURE / USER FLOW</span>
        </div>
        <div class="case-flow-intro">
          <h2>{study.flow.title}</h2>
          <p>{study.flow.body}</p>
        </div>
        <div class="flow-track">
          {study.flow.steps.map((step) => (
            <article class="flow-card">
              <span class="flow-number">{step.number}</span>
              <h3>{step.label}</h3>
              <p>{step.detail}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="case-section case-dark-block">
        <div class="wrap">
          <div class="case-section-label">
            <span class="eyebrow">07</span>
            <span class="case-section-label-name">KEY DESIGN DECISIONS</span>
          </div>
          <div class="decision-list">
            {study.decisions.map((decision) => (
              <article class="decision-row">
                <span class="decision-number">{decision.number}</span>
                <h3>{decision.title}</h3>
                <p>{decision.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="case-section wrap">
        <div class="case-section-label">
          <span class="eyebrow">08</span>
          <span class="case-section-label-name">SYSTEM / TECHNICAL WORK</span>
        </div>
        <div class="case-two-col">
          <h2>{study.system.title}</h2>
          <div>
            <p class="case-lead">{study.system.body}</p>
            <div class="system-stack">
              {study.system.layers.map((layer, index) => (
                <div class="system-layer">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <div>
                    <strong>{layer.label}</strong>
                    <p>{layer.detail}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="case-section case-outcome wrap">
        <div class="case-section-label">
          <span class="eyebrow">09</span>
          <span class="case-section-label-name">OUTCOME</span>
        </div>
        <div class="outcome-grid">
          <h2>{study.outcome.title}</h2>
          <div>
            <p class="case-lead">{study.outcome.body}</p>
            <div class="outcome-facts">
              {study.outcome.facts.map((fact) => (
                <span>{fact}</span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="case-end wrap">
        <a class="button primary" href="/start-a-project">START A PROJECT ↗</a>
        <a class="text-link" href="/work">BACK TO WORK →</a>
      </section>
    </div>
  ) : (
    <div class="case-study">
      <section class="case-hero wrap">
        <a class="back-link" href="/work">← ALL WORK</a>
        <span class="eyebrow">{project.number} / {project.category}</span>
        <h1>{project.title}<span>.</span></h1>
        <p>{project.description}</p>
      </section>
      <section class="case-hero-visual wrap">
        <figure class="case-visual"><img src={project.image} alt={`${project.title} ${project.category.toLowerCase()} design`} fetchpriority="high" /><figcaption><span>{project.number} / {project.category}</span><span>PageFix project</span></figcaption></figure>
      </section>
      {projectVisuals[project.slug]?.length > 0 && (
        <section class="case-gallery wrap" aria-labelledby="case-gallery-title">
          <div class="case-gallery-heading"><span class="eyebrow">Inside the project</span><h2 id="case-gallery-title">A closer look at the work.</h2><p>Screens and visuals from the project.</p></div>
          <div class="case-gallery-grid">
            {projectVisuals[project.slug].map((visual, index) => (
              <figure class="case-gallery-item"><img src={visual.src} alt={visual.alt} loading="lazy" /><figcaption><span>{String(index + 1).padStart(2, '0')}</span>{visual.caption}</figcaption></figure>
            ))}
          </div>
        </section>
      )}
      <section class="case-end wrap">
        <a class="button primary" href="/start-a-project">START A PROJECT ↗</a>
        <a class="text-link" href="/work">BACK TO WORK →</a>
      </section>
    </div>
  )}
</Layout>
